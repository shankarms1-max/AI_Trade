# Isolated AST_FUTURES_V1_DIRECT PAPER worker. Copy to .env.ast-direct (git-ignored) on the research host only.
AST_DIRECT_POSTGRES_DB=ast_direct
AST_DIRECT_POSTGRES_USER=ast_direct
AST_DIRECT_POSTGRES_PASSWORD=change-me
AST_DIRECT_ENABLED=true
# Strategy parameters are frozen in code (22 / 3.9 / OR 09:15-09:30 / exit 15:20). Only operational fields here.
AST_DIRECT_CONFIG_JSON={"lot_size":65,"friction_points_per_round_trip":2.0}
AST_DIRECT_CAPTURE_OFFSET_SECONDS=10
AST_DIRECT_KILL_SWITCH=false
COLLECTOR_HOLIDAYS=
# Read-only Kotak Neo market-data client (consumer key only; no trading login).
KOTAK_CONSUMER_KEY=
