# Production deployment template. Copy to .env.production and replace placeholders.
# Never commit .env.production. URL-encode special password characters in DATABASE_URL.

# Database
POSTGRES_DB=nifty_research
POSTGRES_USER=nifty_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://nifty_app:CHANGE_ME_STRONG_PASSWORD@postgres:5432/nifty_research

# Application and timezone
APP_ENV=production
TZ=Asia/Kolkata
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
ENABLE_API_DOCS=false
# Same-origin production requests need no CORS entry. Comma-separate trusted origins only.
CORS_ALLOWED_ORIGINS=

# Kotak Neo read-only market data
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_TOTP_SECRET=
KOTAK_MPIN=
KOTAK_OPTION_CHAIN_DIAGNOSTICS=false

# Collection and market calendar
COLLECTOR_INTERVAL_MINUTES=3
COLLECTOR_START_TIME=09:18
COLLECTOR_END_TIME=15:27
COLLECTOR_HOLIDAYS=

# Pipeline: deterministic stages run automatically; AI remains off by default.
PIPELINE_AFTER_SNAPSHOT=true
PIPELINE_RUN_AI_RESEARCH=false

# Optional OpenAI research
OPENAI_API_KEY=
AI_RESEARCH_MODEL=
AI_MAX_RETRIES=1
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

# Shadow-only research limits; configure deliberately before expecting approvals.
SHADOW_RISK_CAPITAL_BASE=
SHADOW_RISK_MAX_LOSS_PER_TRADE=
SHADOW_RISK_MAX_CAPITAL_PER_TRADE=
SHADOW_RISK_MAX_DAILY_LOSS=
SHADOW_RISK_MAX_TRADES_PER_DAY=1

# Optional outbound-only Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=2
TELEGRAM_NOTIFY_OPERATIONAL=true
TELEGRAM_NOTIFY_REGIME=true
TELEGRAM_NOTIFY_STRATEGY=true
TELEGRAM_NOTIFY_RISK=true
TELEGRAM_NOTIFY_SHADOW=true
TELEGRAM_NOTIFY_DAILY_SUMMARY=true
TELEGRAM_SEND_STARTUP_MESSAGE=false
TELEGRAM_DAILY_SUMMARY_TIME=15:40

# Observability
OBS_COLLECTOR_WORKER_ID=collector-main
OBS_COLLECTOR_HEARTBEAT_SECONDS=60
OBS_EXPECTED_SNAPSHOT_INTERVAL_SECONDS=180
OBS_DATA_FRESH_HEALTHY_SECONDS=300
OBS_DATA_FRESH_DEGRADED_SECONDS=600

# Frontend build: blank means same-origin /api through Caddy.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_POLL_INTERVAL_MS=30000

# Caddy: use :80 for initial static-IP HTTP testing, or a domain for automatic HTTPS.
SITE_ADDRESS=:80

# Host-side backup retention used by scripts/backup_postgres.sh.
BACKUP_RETENTION_DAYS=14
