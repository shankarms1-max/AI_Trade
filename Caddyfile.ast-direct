# Isolated AST Direct monitoring ingress. Basic auth for every request; only the Next.js frontend is exposed.
# The read API and PostgreSQL stay on the internal ast_direct network.
{$SITE_ADDRESS} {
	encode zstd gzip

	basic_auth {
		{env.APP_AUTH_USER} {env.APP_AUTH_HASH}
	}

	handle {
		reverse_proxy {$AST_DIRECT_FRONTEND_UPSTREAM:ast-direct-frontend:3000}
	}

	# Every page and data response sits behind authentication: never reusable by a shared cache.
	# Content-hashed build assets (no data or secrets) keep their immutable caching.
	# Deferred so it overrides upstream values (for example the prerendered page's s-maxage).
	@authenticated not path /_next/static/*
	header @authenticated {
		defer
		Cache-Control "private, no-store"
	}

	# Ingress-generated errors (including the Basic-auth 401 challenge) are never cacheable either.
	handle_errors {
		header Cache-Control "private, no-store"
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
