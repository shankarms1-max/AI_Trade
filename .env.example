# Required for Phase 1 market-data endpoints. Generate in NEO app/web:
# More -> Trade API -> Generate application.
KOTAK_CONSUMER_KEY=

# Not required by the current read-only snapshot. Reserved for a future
# authenticated session if Kotak changes an endpoint or account setup requires it.
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_TOTP_SECRET=
KOTAK_MPIN=

APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
TZ=Asia/Kolkata
KOTAK_STRIKE_RANGE=10
KOTAK_NIFTY_STRIKE_STEP=50
# Enable only while diagnosing broker schema changes. Output is allowlisted/redacted.
KOTAK_OPTION_CHAIN_DIAGNOSTICS=false

# Local-development example only; use a real secret outside local development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nifty_research
POSTGRES_DB=nifty_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

COLLECTOR_INTERVAL_MINUTES=3
COLLECTOR_START_TIME=09:18
COLLECTOR_END_TIME=15:27
# Optional comma-separated ISO dates, for example 2026-01-26,2026-03-03
COLLECTOR_HOLIDAYS=

# Phase 11 read-only observability.
OBS_COLLECTOR_WORKER_ID=collector-main
OBS_COLLECTOR_HEARTBEAT_SECONDS=60
OBS_EXPECTED_SNAPSHOT_INTERVAL_SECONDS=180
OBS_DATA_FRESH_HEALTHY_SECONDS=300
OBS_DATA_FRESH_DEGRADED_SECONDS=600
OBS_PIPELINE_DEGRADED_FRACTION=0.5

# Phase 12 outbound-only Telegram notifications. Keep disabled until configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=2
TELEGRAM_NOTIFY_OPERATIONAL=true
TELEGRAM_NOTIFY_REGIME=true
TELEGRAM_NOTIFY_STRATEGY=true
TELEGRAM_NOTIFY_RISK=true
TELEGRAM_NOTIFY_SHADOW=true
TELEGRAM_NOTIFY_DAILY_SUMMARY=true
TELEGRAM_NOTIFY_RANGE=false
TELEGRAM_SEND_STARTUP_MESSAGE=false
TELEGRAM_DAILY_SUMMARY_TIME=15:40

# Phase 3 deterministic research defaults.
FEATURE_TOP_N=5
FEATURE_MIN_DATA_COVERAGE=0.6
FEATURE_CLUSTER_MAX_FRACTION=0.6
FEATURE_OPENING_RANGE_START=09:15
FEATURE_OPENING_RANGE_END=09:30
FEATURE_OPENING_RANGE_MIN_SAMPLES=4
FEATURE_VIX_LOW=12
FEATURE_VIX_ELEVATED=16
FEATURE_VIX_HIGH=22

# Phase 4 deterministic research-classifier defaults.
REGIME_MIN_CONFIDENCE=60
REGIME_MIN_DIRECTIONAL_MARGIN=2.0
REGIME_MIN_CONTRACTS=10
REGIME_SMALL_MOVE_PCT=0.05
REGIME_PCR_LOW=0.8
REGIME_PCR_HIGH=1.2
REGIME_PRICE_WEIGHT=3
REGIME_DYNAMIC_OI_WEIGHT=4
REGIME_POSITIONING_WEIGHT=4
REGIME_FUTURES_WEIGHT=2
REGIME_STATIC_OI_WEIGHT=1.5
REGIME_PCR_WEIGHT=1
REGIME_OI_DEPENDENCY_CAP=6
REGIME_LOW_QUALITY_CONFIDENCE_CAP=55
REGIME_INSUFFICIENT_CONFIDENCE_CAP=30

# Phase 5: manual/on-demand AI research only. No real key is committed.
OPENAI_API_KEY=
AI_RESEARCH_MODEL=
AI_MAX_RETRIES=1
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=
AI_CONFIDENCE_CAP_INSUFFICIENT=40
AI_CONFIDENCE_CAP_LOW=55
AI_CONFIDENCE_CAP_MEDIUM=75
AI_CONFIDENCE_CAP_HIGH=90

# Phase 6: deterministic hypothetical candidates only; no execution.
STRATEGY_MIN_REGIME_CONFIDENCE=60
STRATEGY_MIN_EVIDENCE_QUALITY=MEDIUM
STRATEGY_REQUIRE_STRUCTURE_REFERENCE=true
STRATEGY_MIN_SHORT_DISTANCE_POINTS=100
STRATEGY_MIN_SHORT_DISTANCE_PCT=0.25
STRATEGY_ALLOWED_SPREAD_WIDTHS=50,100,150,200
STRATEGY_MIN_SHORT_PREMIUM=1
STRATEGY_MIN_NET_CREDIT=1
STRATEGY_MIN_CREDIT_TO_WIDTH_RATIO=0.03
STRATEGY_MIN_SHORT_OPEN_INTEREST=100
STRATEGY_MIN_LONG_OPEN_INTEREST=100
STRATEGY_MIN_SHORT_VOLUME=1
STRATEGY_MIN_LONG_VOLUME=1
STRATEGY_REQUIRE_USABLE_VOLUME=false
STRATEGY_MAX_BID_ASK_SPREAD_PCT=30
STRATEGY_MAX_CANDIDATES=5
STRATEGY_MAX_SNAPSHOT_AGE_SECONDS=600

# Phase 7: deterministic veto-only risk approval. Monetary limits are intentionally blank.
RISK_MAX_LOSS_PER_TRADE=
RISK_MAX_CAPITAL_PER_TRADE=
RISK_MAX_TRADES_PER_DAY=1
RISK_MAX_DAILY_LOSS=
RISK_MAX_SPREAD_WIDTH=200
RISK_MIN_NET_CREDIT=1
RISK_MIN_CREDIT_TO_WIDTH=0.03
RISK_MIN_SHORT_OI=100
RISK_MIN_LONG_OI=100
RISK_MIN_SHORT_VOLUME=1
RISK_MIN_LONG_VOLUME=1
RISK_REQUIRE_VOLUME=true
RISK_MAX_BID_ASK_SPREAD_PCT=30
RISK_ENTRY_START_TIME=09:35
RISK_ENTRY_END_TIME=13:30
RISK_MIN_REGIME_CONFIDENCE=60
RISK_MIN_EVIDENCE_QUALITY=MEDIUM
RISK_REQUIRE_BID_ASK=false
RISK_ALLOW_LTP_ESTIMATE=true
RISK_MAX_SNAPSHOT_AGE_SECONDS=600
RISK_ALLOW_EXPIRY_DAY=false
RISK_REQUIRE_INTRADAY_OI=true
RISK_REQUIRED_CONSECUTIVE_DIRECTIONAL_SNAPSHOTS=2
RISK_REQUIRE_CANDIDATE_STABILITY=false
RISK_CANDIDATE_STABILITY_SNAPSHOTS=2
RISK_MARKET_EVENTS_JSON=[]

# Phase 8: observed-price shadow research only; never sends broker orders.
SHADOW_PROFIT_TARGET_CREDIT_CAPTURE_PCT=50
SHADOW_STOP_LOSS_CREDIT_MULTIPLE=1.5
SHADOW_FORCE_EXIT_TIME=15:20
SHADOW_HARD_EXIT_CUTOFF=15:29
SHADOW_EXIT_ON_OPPOSITE_REGIME=true
SHADOW_EXIT_ON_STRUCTURAL_BREACH=true
SHADOW_MAX_NEW_TRADES_PER_DAY=1
SHADOW_ALLOW_MULTIPLE_OPEN_TRADES=false
SHADOW_RISK_CAPITAL_BASE=
SHADOW_RISK_MAX_LOSS_PER_TRADE=
SHADOW_RISK_MAX_CAPITAL_PER_TRADE=
SHADOW_RISK_MAX_DAILY_LOSS=
SHADOW_RISK_MAX_TRADES_PER_DAY=1

# Phase 9 orchestration. Recommended for Monday shadow-only collection.
PIPELINE_AFTER_SNAPSHOT=false
PIPELINE_RUN_AI_RESEARCH=false

# Phase 14 statistical alpha remains opt-in until live market-hours validation.
ALPHA_ENGINE_ENABLED=false
REGIME_USE_STATISTICAL_ALPHA=false
ALPHA_PRICE_SOURCE=FUTURE
ALPHA_PRICE_HORIZON_SECONDS=300
ALPHA_MIN_HORIZON_SECONDS=240
ALPHA_MAX_HORIZON_SECONDS=420
ALPHA_LOOKBACK_CLOCK_MODE=TRADING_MINUTES
ALPHA_HYPOTHESIS_TYPE=CONTINUATION
VOLUME_MAX_INTERVAL_SECONDS=420
VOLATILITY_MIN_VALID_LEVEL=0.00001
ALPHA_HORIZON_TOLERANCE_SECONDS=120
ALPHA1_LOOKBACK_MINUTES=800
ALPHA2_LOOKBACK_MINUTES=300
ALPHA_MIN_RANK_OBSERVATIONS=50
ALPHA_REQUIRED_CONSECUTIVE_CONFIRMATIONS=2
STRATEGY_VOLATILITY_BUFFER_ENABLED=false

# Phase 15 isolated intraday paper scalper. Keep disabled unless running the
# dedicated local worker after applying migration 0016_scalper.
SCALPER_ENABLED=false
SCALPER_INTERVAL_SECONDS=15
SCALPER_START_TIME=09:20
SCALPER_ENTRY_END_TIME=14:45
SCALPER_FORCED_EXIT_TIME=15:20
SCALPER_STRIKE_RANGE=10
SCALPER_FEATURE_LOOKBACK=12
SCALPER_SIGNAL_MIN_SCORE=80
SCALPER_MIN_CONFIRMATIONS=2
SCALPER_ALLOWED_WIDTHS=100,200,300,400
SCALPER_MIN_SHORT_DISTANCE_POINTS=50
SCALPER_MIN_CREDIT=1
SCALPER_MIN_CREDIT_TO_WIDTH=0.03
SCALPER_MAX_BID_ASK_SPREAD_PCT=20
SCALPER_MAX_QUOTE_AGE_SECONDS=30
SCALPER_MIN_OPEN_INTEREST=100
SCALPER_MIN_VOLUME=1
SCALPER_MAX_OPEN_POSITIONS=1
SCALPER_LOTS=1
SCALPER_MAX_TRADES_PER_DAY=10
SCALPER_MAX_LOSS_PER_TRADE=25000
SCALPER_HARD_DAILY_LOSS=50000
SCALPER_MAX_CONSECUTIVE_LOSSES=3
SCALPER_COOLDOWN_AFTER_LOSS_SECONDS=300
SCALPER_COOLDOWN_AFTER_EXIT_SECONDS=60
SCALPER_KILL_SWITCH=false
SCALPER_MARKET_EVENTS_JSON=[]
SCALPER_PROFIT_CAPTURE_PCT=50
SCALPER_STOP_CREDIT_MULTIPLE=1.5
SCALPER_TRAILING_ACTIVATION_PCT=35
SCALPER_TRAILING_GIVEBACK_PCT=20
SCALPER_TIME_STOP_MINUTES=30
SCALPER_ENTRY_TTL_SECONDS=60
SCALPER_USE_PHASE14_CONTEXT=true
# Charge inputs remain explicit zero assumptions and net P&L stays unavailable.
SCALPER_COST_SCHEDULE_VERSION=UNCONFIGURED
SCALPER_BROKERAGE_PER_ORDER=0
SCALPER_EXCHANGE_RATE=0
SCALPER_STT_RATE=0
SCALPER_GST_RATE=0
SCALPER_STAMP_RATE=0
SCALPER_SEBI_RATE=0
SCALPER_SLIPPAGE_POINTS_PER_LEG=0


# Phase 14.2: opt-in Codespace/offline credit-spread research only.
PHASE14_2_STRATEGY_LOGIC_ENABLED=false
PHASE14_2_1_REPLAY_INTEGRITY_ENABLED=false
REPLAY_ALLOW_UNKNOWN_DEPTH=false
REPLAY_ALLOW_0DTE=false
REPLAY_EXPECTED_INTERVAL_SECONDS=180
REPLAY_INTERVAL_TOLERANCE_SECONDS=30
REPLAY_MAX_FILL_DELAY_SECONDS=240
REPLAY_MAX_PATH_GAP_SECONDS=240
THETA_CARRY_ENABLED=false
STRATEGY_ALLOWED_WIDTHS_POINTS=100,200,300,400
STRATEGY_FAMILY_MODE=BOTH
DIRECTIONAL_ALPHA_MIN_STRENGTH=MODERATE
THETA_CARRY_MAX_OPPOSING_ALPHA_STRENGTH=MODERATE
THETA_CARRY_MIN_SURVIVAL_SCORE=70
THETA_CARRY_MIN_CARRY_SCORE=40
EXPECTED_MOVE_SOURCE=AUTO
# Blank leaves the expected-move distance gate unset; distance still affects ranking.
# EXPECTED_MOVE_MIN_DISTANCE_UNITS=1.0
GAMMA_RISK_DTE_BUCKETS=[0,1,3,7]
# Score weights are JSON dictionaries; see CreditSpreadPolicy and Phase 14.2 report.
# Existing RISK_MAX_SPREAD_WIDTH remains 200; research widths do not bypass it.
